# Server
PORT=8000

# Database
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Storage (Day 4)
# Provider options: azurite | azure
STORAGE_PROVIDER=azurite
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_CONTAINER_NAME=videos
# For local Azurite
AZURITE_HOST=127.0.0.1
AZURITE_PORT=10000
# For real Azure (leave key unset when using Managed Identity / DefaultAzureCredential)
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONNECTION_STRING=
MAX_VIDEO_UPLOAD_SIZE_BYTES=524288000
SAS_EXPIRY_MINUTES=15

# Video Processing Worker (Day 5)
VIDEO_QUEUE_NAME=video-processing
WORKER_CONCURRENCY=2
